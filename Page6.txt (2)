          <div style={styles.cardMeta}>
            <Icon name="location" size={11} color={C.textDim} />
            {material.sampleSourceArea || "Source area not specified"}
          </div>
          <div style={styles.cardMeta}>
            <Icon name="clock" size={11} color={C.textDim} />
            Uploaded {formatDateTime(material.sampleUploadedAt)}
            {material.sampleExpiresAt ? ` | expires ${formatDateDisplay(material.sampleExpiresAt)}` : ""}
          </div>
        </div>
      </div>

      <div style={styles.cardTotals}>
        <div style={styles.cardTotal}>
          <span style={styles.cardTotalValue}>{material.totalVehicles}</span>
          <span style={styles.cardTotalLabel}>vehicles</span>
        </div>
        <div style={styles.cardTotal}>
          <span style={styles.cardTotalValue}>{material.totalTons}</span>
          <span style={styles.cardTotalLabel}>tons</span>
        </div>
      </div>

      <VehicleBreakdown styles={styles} vehicles={material.vehicles} />

      {material.sampleAdminNote ? (
        <div style={styles.adminNote}>
          <Icon name="info" size={13} color={C.gold} />
          <span style={styles.adminNoteText}>{material.sampleAdminNote}</span>
        </div>
      ) : null}

      <div style={styles.cardActions}>
        <button
          type="button"
          onClick={() => onViewImage(material)}
          disabled={!hasImage || busy}
          style={mergeStyles(styles.cardAction, (!hasImage || busy) ? styles.iconBtnDisabled : {})}
          className="p6-focusable p6-ghost"
        >
          <Icon name="image" size={14} />
          View image
        </button>
        <button
          type="button"
          onClick={onEdit}
          disabled={busy}
          style={mergeStyles(styles.cardActionGold, busy ? styles.iconBtnDisabled : {})}
          className="p6-focusable"
        >
          <Icon name="edit" size={13} />
          Edit selection
        </button>
      </div>
    </article>
  );
}

